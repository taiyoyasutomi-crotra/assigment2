# Postgres 接続文字列。Supabase の場合は
# Project Settings > Database > Connection string (URI) の値を使う。
# Vercel から接続する場合は Transaction Pooler (port 6543) を推奨。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fanmeeting

# Supabase 等 SSL 必須の DB に接続する場合は true
DATABASE_SSL=false

# セッション Cookie の署名キー。本番では必ずランダムな値に変更する
AUTH_SECRET=change-me-to-a-random-string

# このアプリの公開 URL(告知文・メール内のリンクに使う)
APP_URL=http://localhost:3000

# Resend の API キー。未設定の場合はメールを送らずコンソールに出力する
# (通知履歴には記録されるので、画面デモは API キーなしでも可能)
RESEND_API_KEY=

# 送信元メールアドレス(Resend で認証済みのドメイン、または onboarding@resend.dev)
MAIL_FROM=onboarding@resend.dev

# 認証モード:
#   mock      … シード会員から選んでログイン(開発・デモ用。デフォルト)
#   fans_code … Fans'(fansnet.jp)会員向け。管理画面で取り込んだ会員名簿(CSV)と
#               照合し、名簿にあるメールアドレスにのみログインリンクを送る
AUTH_MODE=mock

# 送信キューの1日予算(Resend分)。無料枠100通/日から認証メール分を残す。既定90
NOTIFY_DAILY_LIMIT=90

# Brevo の API キー(任意)。設定すると第2の送信チャネルとして併用し、
# 無料枠を合算して1日380通まで送れる(Brevo 無料枠は300通/日)
BREVO_API_KEY=

# 送信キューの1日予算(Brevo分)。既定290
NOTIFY_BREVO_DAILY_LIMIT=290
